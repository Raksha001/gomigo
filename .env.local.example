# ---- World ID 4.0 (Developer Portal: https://developer.world.org) ----
# Public (client) values:
NEXT_PUBLIC_WLD_APP_ID=app_your_app_id
NEXT_PUBLIC_WLD_ACTION=gomipass-dropoff
NEXT_PUBLIC_WLD_RP_ID=rp_your_rp_id

# Server-only secrets (NEVER prefix with NEXT_PUBLIC):
# The RP signer private key — used to sign the rp_context for each request.
WLD_RP_ID=rp_your_rp_id
WLD_RP_PRIVATE_KEY=0xyour_rp_signer_private_key
# Staging/sandbox verification token (24h window). Sent as x-staging-verification-token
# so the v4 endpoint accepts sandbox proofs. Not needed for production proofs.
WLD_STAGING_TOKEN=sk_your_staging_token

# ---- ENSv2 on Sepolia ----
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Leave blank until real names are deployed → deterministic ENS mock fallback.
NEXT_PUBLIC_ENS_UNIVERSAL_RESOLVER=
