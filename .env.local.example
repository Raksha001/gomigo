# =========================================================================
# GomiGo environment variables.
# Copy to .env.local for local dev, and set the SAME keys in Vercel
# (Project → Settings → Environment Variables). Values live in your local
# .env.local — copy them across. NEXT_PUBLIC_* are exposed to the browser;
# the others are server-only secrets.
# =========================================================================

# ---- World ID 4.0 (https://developer.world.org) ----
NEXT_PUBLIC_WLD_APP_ID=app_your_app_id
NEXT_PUBLIC_WLD_ACTION=gomipass-dropoff
NEXT_PUBLIC_WLD_RP_ID=rp_your_rp_id
# "production" | "staging" | "sandbox" (which World App environment to verify against)
NEXT_PUBLIC_WLD_ENV=production

# Server-only World ID secrets (NEVER prefix with NEXT_PUBLIC):
WLD_RP_ID=rp_your_rp_id
WLD_RP_PRIVATE_KEY=0xyour_rp_signer_private_key
WLD_STAGING_TOKEN=sk_your_staging_token

# ---- ENSv2 on Sepolia ----
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://1rpc.io/sepolia
# Our deployed subname registry (the app reads live registration state from it).
NEXT_PUBLIC_ENS_REGISTRY=0xyour_registry_address
# Optional ENSv2 UniversalResolver (blank = registry-only reads).
NEXT_PUBLIC_ENS_UNIVERSAL_RESOLVER=
# Server-only: funds the "list a bin" on-chain registration (throwaway testnet key).
DEPLOYER_PRIVATE_KEY=0xyour_throwaway_testnet_key

# ---- Maps ----
# Mapbox public token (pk...). Safe to expose.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
